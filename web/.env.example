DATABASE_URL="postgresql://beautyfind:beautyfind@localhost:5432/beautyfind"
# Direct connection for migrations (same as DATABASE_URL locally; Neon on Vercel sets it)
DATABASE_URL_UNPOOLED="postgresql://beautyfind:beautyfind@localhost:5432/beautyfind"
# Signs session cookies and guest links. Use a long random string in production.
SESSION_SECRET="change-me"
# console | (future: whatsapp BSP / SMS gateway adapter names)
MESSAGING_ADAPTER="console"
# Dev only: every OTP is this code (ignored in production)
DEV_FIXED_OTP="123456"
# Absolute origin used in email/WhatsApp links
SITE_URL="http://localhost:3000"
# local | blob (Vercel Blob; needs BLOB_READ_WRITE_TOKEN from a connected Blob store)
STORAGE_ADAPTER="local"
UPLOAD_DIR=".data/uploads"
# Local production-mode testing only. Never set in a real deployment.
# ALLOW_CONSOLE_MESSAGING="1"
# 32 random bytes, base64 (openssl rand -base64 32). Encrypts health data, clinical notes, provider credentials.
DATA_KEY=""
# Allow the sandbox payment/invoicing provider in production mode (demos only)
# ALLOW_SANDBOX_PAYMENTS="1"
# Test deployments: noindex everywhere and a "test environment" bar
# STAGING="1"

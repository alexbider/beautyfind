# Environment for the self-hosted import worker (docker-compose.worker.yml). Copy to .env.worker and
# fill in; .env.worker is ignored by git. Same names as the GitHub Actions secrets in
# .github/workflows/import.yml; docs/import.md explains each one. Leave a line out to disable that source.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# APIFY_TOKEN=
# YOUTUBE_API_KEY=
SITE_URL=https://beautyfind.vercel.app
REVALIDATE_SECRET=
STORAGE_ADAPTER=blob
BLOB_READ_WRITE_TOKEN=

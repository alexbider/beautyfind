# The import worker as a container, for running it on your own machine or VPS instead of GitHub
# Actions. Same code, same environment variables (see docs/import.md, "What you need to provide").
# Chromium for the worker's own browser (Crawlee + Playwright) is installed in the image.
#
#   docker compose -f docker-compose.worker.yml up -d --build
#
# The container loops: work the next queued run (up to IMPORT_MAX_MINUTES), then wait
# IMPORT_IDLE_SECONDS and look again. Stop it any time; runs resume where they stopped.

FROM node:22-bookworm-slim

ENV NODE_ENV=production \
    PLAYWRIGHT_BROWSERS_PATH=/ms-playwright \
    PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1

WORKDIR /app

# Dependencies first, so code changes do not reinstall them. postinstall runs prisma generate.
COPY package.json package-lock.json ./
COPY prisma ./prisma
RUN npm ci --include=dev

# Headless Chromium with its system libraries, matching the installed playwright-core.
RUN npx playwright-core install --with-deps chromium && rm -rf /var/lib/apt/lists/*

COPY . .

# Neither root nor a shared home: the browser runs as an ordinary user.
RUN groupadd -r worker && useradd -r -g worker -m worker && chown -R worker:worker /app /ms-playwright
USER worker

CMD ["sh", "-c", "while true; do npm run import:work -- --max-minutes \"${IMPORT_MAX_MINUTES:-330}\"; sleep \"${IMPORT_IDLE_SECONDS:-60}\"; done"]
